# --- Supabase (client project ref ciodkacwdbktuimriuss, Stockholm). Copy to .env.local; never commit real values. ---
# Public by design: protected by Row Level Security, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_, never commit it, never paste it in chat.
# The app does not read it today (src/lib/supabase/admin.ts is not used); leave empty unless an admin task needs it.
SUPABASE_SERVICE_ROLE_KEY=
# "demo" (default): public sample demo, no sign-in, nothing stored. "required": sign-in needed for every page and API.
# Switch to "required" only after the migration is applied and a first user has a membership (docs/DATABASE.md).
AUTH_MODE=demo

# Server-only. Reserved for the PLANNED Claude drafting; no code reads it today.
# This is an Anthropic Console API key, billed per usage. A Claude Team subscription does NOT include API access.
ANTHROPIC_API_KEY=
# Reserved flag for the planned Claude drafting. Keep false: only template drafting exists, and setting it to
# true changes nothing except a note saying Claude drafting is not built yet. No API call is ever made.
CONTENT_AGENT_USE_CLAUDE=false
