# --- Supabase (client project ref ciodkacwdbktuimriuss, Stockholm). Copy to .env.local; never commit real values. ---
# Public by design: protected by Row Level Security, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_, never commit it, never paste it in chat.
# The app does not read it today (src/lib/supabase/admin.ts is not used); leave empty unless an admin task needs it.
SUPABASE_SERVICE_ROLE_KEY=
# "demo" (default): public sample demo, no sign-in, nothing stored. "required": sign-in needed for every page and API.
# Switch to "required" only after the migration is applied and a first user has a membership (docs/DATABASE.md).
AUTH_MODE=demo

# ---- AI drafting (OpenAI), Content & Marketing pilot. ALL server-only; never prefix with NEXT_PUBLIC_, never commit, never paste in chat. ----
# Off unless AI_ENABLED is exactly "true". It only ever runs for a signed-in LIVE organisation (AUTH_MODE=required), never in the public demo.
AI_ENABLED=false
# Server-only secret. Set it in .env.local and, later, in the authenticated app's Vercel Production variables. Never in the public demo project.
OPENAI_API_KEY=
# Model name, chosen by the owner. Defaults to gpt-6-sol when blank.
OPENAI_MODEL=gpt-6-sol
# US dollars per MILLION tokens, from the provider's price list for the chosen model. Required: with no prices the spending limit
# cannot be enforced and AI stays off. Left blank on purpose; there is no default.
OPENAI_PRICE_INPUT_USD_PER_MTOK=
OPENAI_PRICE_OUTPUT_USD_PER_MTOK=
# Spend and rate limits (defaults shown). Estimated worst case is reserved before every call; failed calls still count.
AI_MONTHLY_BUDGET_USD=20
AI_DAILY_CALLS_PER_ORG=100
AI_CALLS_PER_USER_PER_MINUTE=5
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_MS=30000

# Server-only. Reserved for the PLANNED Claude drafting; no code reads it today.
# This is an Anthropic Console API key, billed per usage. A Claude Team subscription does NOT include API access.
ANTHROPIC_API_KEY=
# Reserved flag for the planned Claude drafting. Keep false: only template drafting exists, and setting it to
# true changes nothing except a note saying Claude drafting is not built yet. No API call is ever made.
CONTENT_AGENT_USE_CLAUDE=false

# ---- Amazon Intelligence (M5): Amazon India, SP-API, READ-ONLY. All server-only; never prefix with NEXT_PUBLIC_, never commit, never paste in chat. ----
# "sandbox" (default) uses Amazon's simulated test data and is labelled as such in the app. Production is an explicit choice, never inferred.
AMAZON_SP_ENVIRONMENT=sandbox
# Login with Amazon (LWA) credentials of the PRIVATE SP-API app, and the refresh token from the seller's self-authorisation.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# The seller's own id (Seller Central > Account Info > Merchant Token). Needed to read listings.
AMAZON_SELLER_ID=
# Optional. Defaults to Amazon India (A21TJRUUN4KGV); verified against Amazon's marketplace-participation answer before any sync.
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# ---- Google Maps B2B lead generation (PLANNED; Phases 2 and 3 only, no real transport exists) ----
# Kill switch for any Google Places call. Keep false: nothing reads a Google key, and no billing or live call is authorised.
# No API key variable is defined on purpose; one is added only when a live connection is separately approved.
GOOGLE_PLACES_ENABLED=false
